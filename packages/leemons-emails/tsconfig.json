{
  "extends": "../../tsconfig.base.json",
  "compilerOptions": {
    "declaration": true,
    "esModuleInterop": true,
    "outDir": "./dist/esm",
    "rootDir": "./src",
    "target": "ES6",
    "module": "ESNext",
    "moduleResolution": "node",
    "lib": ["ES6", "DOM"],
    "strict": true,
    "skipLibCheck": true,
    "jsx": "react-jsx"
  },
  "include": ["./src/**/*"]
}
