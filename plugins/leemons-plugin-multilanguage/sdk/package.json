{
  "name": "@leemons/multilanguage",
  "version": "0.0.72",
  "description": "Multilanguage service for Leemons",
  "exports": {
    ".": {
      "import": "./dist/esm/index.js",
      "require": "./dist/cjs/index.js"
    }
  },
  "main": "dist/cjs/index.js",
  "module": "dist/esm/index.js",
  "types": "dist/esm/index.d.ts",
  "scripts": {
    "build": "yarn clean && yarn build:esm && yarn build:cjs",
    "build:esm": "tsc -p tsconfig.json",
    "build:cjs": "tsc -p tsconfig.cjs.json",
    "build:watch": "yarn build:esm -- --watch",
    "clean": "rimraf dist"
  },
  "keywords": [],
  "author": {
    "email": "hi@leemons.io",
    "name": "Leemons Edtech Solutions",
    "url": "https://www.leemons.io"
  },
  "publishConfig": {
    "access": "public",
    "registry": "https://registry.npmjs.org/"
  },
  "maintainers": [
    {
      "email": "hi@leemons.io",
      "name": "Leemons Edutech Solutions",
      "url": "https://www.leemons.io"
    }
  ],
  "license": "SEE LICENSE IN LICENSE.md",
  "devDependencies": {
    "rimraf": "^6.0.1",
    "typescript": "^5.5.2",
    "@types/flat": "^5.0.5",
    "@types/lodash": "^4.14.202",
    "@types/object-hash": "^3.0.6",
    "@types/uuid": "^9.0.8"
  },
  "dependencies": {
    "@leemons/mongodb-helpers": "0.0.72",
    "@leemons/mongodb": "0.0.72",
    "@leemons/service-name-parser": "0.0.42",
    "@leemons/moleculer": "0.0.1",
    "flat": "^5",
    "lodash": "^4.17.21",
    "object-hash": "^3.0.0",
    "uuid": "^9.0.1"
  }
}
